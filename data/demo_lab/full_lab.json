  "findings": [
    {
      "id": "finding-web-tls",
      "lab_id": "lab-001",
      "asset_id": "asset-web",
      "title": "Weak TLS Configuration",
      "description": "The web server supports TLS 1.0 and 1.1 which are deprecated protocols. This may allow downgrade attacks.",
      "category": "configuration",
      "severity": "medium",
      "external_reference": null,
      "evidence_ids": ["ev-tls-scan"],
      "source": "synthetic_scan_report",
      "status": "open",
      "remediation": "Disable TLS 1.0 and 1.1. Configure the server to support only TLS 1.2 and TLS 1.3."
    },
    {
      "id": "finding-web-headers",
      "lab_id": "lab-001",
      "asset_id": "asset-web",
      "title": "Missing Security Headers",
      "description": "The web server response lacks several recommended security headers including X-Content-Type-Options, X-Frame-Options, and Content-Security-Policy.",
      "category": "configuration",
      "severity": "low",
      "external_reference": null,
      "evidence_ids": ["ev-header-check"],
      "source": "synthetic_config_review",
      "status": "open",
      "remediation": "Add X-Content-Type-Options: nosniff, X-Frame-Options: DENY, and a Content-Security-Policy header."
    },
    {
      "id": "finding-app-perms",
      "lab_id": "lab-001",
      "asset_id": "asset-app",
      "title": "Excessive Application Service Permissions",
      "description": "The application service runs with root-level permissions. If compromised, an attacker would have full system access on the application server.",
      "category": "access_control",
      "severity": "high",
      "external_reference": null,
      "evidence_ids": ["ev-app-perms"],
      "source": "synthetic_config_review",
      "status": "open",
      "remediation": "Run the application service under a dedicated, least-privilege user account."
    },
    {
      "id": "finding-app-api-noauth",
      "lab_id": "lab-001",
      "asset_id": "asset-app",
      "title": "Unauthenticated Internal API Endpoint",
      "description": "The /admin/status endpoint on the application server API does not require authentication. It exposes internal system information.",
